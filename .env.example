# Copy this file to .env for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-development-secret

# SQLite is the default and requires no separate service.
PORTFOLIO_DB_ENGINE=sqlite
DJANGO_SQLITE_NAME=db.sqlite3

# To use PostgreSQL instead, uncomment and fill in these values.
# PORTFOLIO_DB_ENGINE=postgresql
# POSTGRES_DB=portfolio
# POSTGRES_USER=portfolio
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
