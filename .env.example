PORTFOLIO_PROFILE_FULL_NAME="Your Name"
PORTFOLIO_PROFILE_PROFESSION="Your Profession"
PORTFOLIO_PROFILE_EMAIL=you@example.com
PORTFOLIO_PROFILE_GITHUB_URL=https://github.com/your-username
PORTFOLIO_PROFILE_LINKEDIN_URL=https://www.linkedin.com/in/your-username/

# Optional: copy examples/home.json to private/home.json and edit it.
# Omit this setting to use the generic example content.
# PORTFOLIO_HOME_CONTENT_FILE=private/home.json

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-development-secret

# SQLite is the default and requires no separate service.
PORTFOLIO_DB_ENGINE=sqlite
DJANGO_SQLITE_NAME=db.sqlite3

# To use PostgreSQL instead, uncomment and fill in these values.
# PORTFOLIO_DB_ENGINE=postgresql
# POSTGRES_DB=portfolio
# POSTGRES_USER=portfolio
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
